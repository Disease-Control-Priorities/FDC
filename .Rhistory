select(wb2021, location_wb, location_gbd)%>%
rename(Country = location_gbd)%>%
right_join(., read.csv("new_events.csv", stringsAsFactors = F))%>%
group_by(wb2021)%>%
summarise(MI_ratio = mean(MI_ratio),
stroke_ratio = mean(stroke_ratio),
